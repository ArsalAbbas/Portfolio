---
import Emblem from '../components/shared/Emblem.astro'
import Base from '../layouts/Base.astro'
---

<Base title="Off the map" description="This page doesn’t exist. Nothing here but grass.">
  <section class="lost wrap">
    <p class="lost__code" aria-label="404">
      <span aria-hidden="true">4</span>
      <Emblem shape="circle" hue="red" />
      <span aria-hidden="true">4</span>
    </p>
    <h1>You’ve wandered off the map.</h1>
    <p>This page doesn’t exist, or it fell through a portal. Either way, there’s nothing here but grass.</p>
    <div class="lost__choices">
      <a class="btn" href="/" style="--hue: var(--green)">Respawn at the start</a>
      <a class="btn btn--ghost" href="/blog/">Read the blog</a>
    </div>
    <p class="lost__hint mono">Psst: type <kbd>nox</kbd> or <kbd>lumos</kbd>.</p>
  </section>
</Base>
