---
import { render } from 'astro:content'
import ReadingBar from '../../components/logbook/ReadingBar.astro'
import Base from '../../layouts/Base.astro'
import { formatDate, getPosts, postUrl, readingMinutes, type Post } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }))
}

interface Props {
  post: Post
  newer?: Post
  older?: Post
}

const { post, newer, older } = Astro.props
const { Content } = await render(post)
const minutes = readingMinutes(post.body)
---

<Base title={post.data.title} description={post.data.description} type="article" published={post.data.date}>
  <ReadingBar />
  <article class="article wrap" data-article>
    <header class="article__head">
      <a class="back" href="/blog/">← Blog</a>
      <h1>
        {post.data.title}
        {post.data.draft && <span class="draft">Draft</span>}
      </h1>
      <p>{post.data.description}</p>
      <div class="article__meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.updated && <span>Updated {formatDate(post.data.updated)}</span>}
        <span>{minutes} min read · +{minutes * 10} XP</span>
        {post.data.tags.map((tag) => <span>#{tag}</span>)}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="article__end" aria-label="More posts">
    {
      older ? (
        <a class="btn btn--small btn--ghost" href={postUrl(older)}>
          ← {older.data.title}
        </a>
      ) : (
        <a class="btn btn--small btn--ghost" href="/blog/">
          ← All posts
        </a>
      )
    }
    {
      newer && (
        <a class="btn btn--small btn--ghost" href={postUrl(newer)}>
          {newer.data.title} →
        </a>
      )
    }
  </nav>
</Base>
