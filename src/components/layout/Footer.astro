---
// The bottom of every page: what the site is built with, and a small hint for keyboards: the
// spell for whichever theme you're not in.
import { site } from '../../data/site'

const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="wrap">
    <span>
      © {year} {site.fullName}. Made of circles, triangles, squares and crosses.
      <span class="footer__stack">Built with Astro, TypeScript and plain CSS.</span>
    </span>
    <span>
      <a href="/blog/">Blog</a> · <a href="/character/">Character</a>
      <span class="footer__psst"> · psst: type <kbd class="footer__spell footer__spell--nox">nox</kbd><kbd class="footer__spell footer__spell--lumos">lumos</kbd></span>
    </span>
  </div>
</footer>
