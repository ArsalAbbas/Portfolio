---
// 01 Quests: the areas I work in, one card each, then where I've worked and what I've made on
// the side. The words live in src/data/quests.ts and src/data/work.ts.
import { quests } from '../../data/quests'
import SectionHead from '../shared/SectionHead.astro'
import Experience from './Experience.astro'
import Projects from './Projects.astro'
import QuestCard from './QuestCard.astro'
---

<section class="section" id="quests" data-section="quests">
  <div class="wrap">
    <SectionHead
      n="01"
      shape="circle"
      hue="red"
      kicker="Quests"
      title="What I work on"
      sub="Mostly at SquadStack.ai, where I build voice AI end to end. First the areas, then my roles and side projects."
    />
    <div class="quests">
      {quests.map((quest) => <QuestCard quest={quest} />)}
    </div>
    <div class="subhead" id="experience"><h3>Experience</h3><span class="eyebrow">Main quest</span></div>
    <Experience />
    <div class="subhead" id="projects"><h3>Projects</h3><span class="eyebrow">Side quests</span></div>
    <Projects />
  </div>
</section>

<script>
  import { initQuests } from './quests'

  initQuests()
</script>
