---
// Things I've made on my own time. One that's online links to it; one you set up yourself has a
// button that copies a prompt for Claude Code; one that isn't out yet says where it's headed; one
// that isn't finished shows how far along it is. Hover one with a screenshot and it pops up above the card. The words live in
// src/data/work.ts.
import { Image } from 'astro:assets'
import { projects } from '../../data/work'
import Shape from '../shared/Shape.astro'
---

<div class="projects">
  {
    projects.map((project) => (
      <article class="card project" style={`--hue: var(--${project.hue})`} data-project>
        {project.shot && (
          <figure class="project__shot">
            <Image src={project.shot.src} alt={project.shot.alt} widths={[540, 1000]} sizes="540px" />
          </figure>
        )}
        <div class="quest__title">
          <Shape name={project.shape} size={22} />
          <h4>{project.name}</h4>
          <span class="project__year">{project.year}</span>
        </div>
        <p class="quest__line">{project.line}</p>
        {project.progress && (
          <p class="project__progress">
            <span class="project__bar" aria-hidden="true">
              <i style={`--p: ${project.progress.done}`} />
            </span>
            {project.progress.label}
          </p>
        )}
        <ul class="project__tags">
          {project.tags.map((tag) => (
            <li class="chip">{tag}</li>
          ))}
        </ul>
        {project.soon && <p class="project__soon">{project.soon}</p>}
        {project.live && (
          <a class="btn btn--small project__live" href={project.live} target="_blank" rel="noreferrer">
            Try it
          </a>
        )}
        {project.prompt && (
          <button class="btn btn--small btn--ghost project__copy" type="button" data-copy={project.prompt}>
            Copy setup prompt
          </button>
        )}
      </article>
    ))
  }
</div>

<script>
  import { initProjects } from './projects'

  initProjects()
</script>
