---
// Sports: a badminton rally and a table-tennis rally that play themselves. All CSS, in
// ./widgets.css.
---

<div class="widget" data-widget="rally">
  <div class="rally">
    <figure class="court">
      <svg viewBox="0 0 300 110" aria-hidden="true">
        <path class="court__floor" d="M10 106 H290"></path>
        <path d="M150 106 V60" stroke-width="3"></path>
        <rect class="court__net" x="146" y="60" width="8" height="22" rx="1"></rect>
        <g class="court__racket court__racket--left">
          <path d="M37.5 89.8 L43.4 102.5" stroke-width="4"></path>
          <ellipse cx="32" cy="78" rx="9" ry="13" transform="rotate(-25 32 78)"></ellipse>
        </g>
        <g class="court__racket court__racket--right">
          <path d="M262.5 89.8 L256.6 102.5" stroke-width="4"></path>
          <ellipse cx="268" cy="78" rx="9" ry="13" transform="rotate(25 268 78)"></ellipse>
        </g>
        <g class="court__arc">
          <g class="court__shuttle">
            <path class="court__feathers" d="M152 21 L139 17 L139 31 L152 27 Z"></path>
            <circle class="court__cork" cx="155.5" cy="24" r="4.5"></circle>
          </g>
        </g>
      </svg>
      <figcaption class="eyebrow">Badminton</figcaption>
    </figure>
    <figure class="court">
      <svg viewBox="0 0 300 76" aria-hidden="true">
        <path class="court__floor" d="M10 72 H290"></path>
        <path d="M70 48 V72 M230 48 V72" stroke-width="3"></path>
        <rect class="court__table" x="40" y="40" width="220" height="8" rx="2"></rect>
        <rect class="court__net" x="148" y="26" width="4" height="14"></rect>
        <g class="court__paddle court__paddle--left">
          <path d="M20 32 L14 46" stroke-width="5"></path>
          <circle class="court__rubber court__rubber--red" cx="24" cy="20" r="13"></circle>
        </g>
        <g class="court__paddle court__paddle--right">
          <path d="M280 32 L286 46" stroke-width="5"></path>
          <circle class="court__rubber" cx="276" cy="20" r="13"></circle>
        </g>
        <g class="court__ball-x">
          <circle class="court__ball" cx="40" cy="18" r="5"></circle>
        </g>
      </svg>
      <figcaption class="eyebrow">Table tennis</figcaption>
    </figure>
  </div>
</div>
