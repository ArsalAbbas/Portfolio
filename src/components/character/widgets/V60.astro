---
// Coffee: a dripper, brewed at ten times the speed by ./v60.ts.
---

<div class="widget" data-widget="v60">
  <div class="brew" data-brew>
    <svg viewBox="0 0 120 156" aria-hidden="true">
      <path class="water" d="M60 2 V46" />
      <path d="M20 44 H100 L70 92 H50 Z" style="fill: var(--card)" />
      <path d="M40 52 L56 86 M60 52 V88 M80 52 L64 86" fill="none" stroke-width="1.6" opacity="0.4" />
      <rect x="38" y="92" width="44" height="9" rx="2" style="fill: var(--card)" />
      <path class="water" d="M60 101 V112" />
      <path d="M28 108 H92 L87 152 H33 Z" style="fill: var(--card)" />
      <rect class="coffee" x="32" y="114" width="56" height="36" />
      <path d="M28 108 H92 L87 152 H33 Z" fill="none" />
    </svg>
    <div>
      <p class="timer" data-timer>0:00</p>
      <button class="btn btn--small" type="button" data-brew-start style="--hue: var(--yellow)">
        Brew a cup
      </button>
    </div>
  </div>
  <p class="fineprint">At ten times the speed, because you have things to do.</p>
</div>
