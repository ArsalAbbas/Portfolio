---
// The Engineer: a few numbers from GitHub, and a button that deploys nothing.
import { stats } from '../../../data/character'
---

<div class="widget" data-widget="stats">
  <div class="widget__title">
    <span class="eyebrow">Stats · GitHub, since January 2024</span>
  </div>
  <div class="stats">
    {
      stats.map((s) => (
        <div class="stat">
          <b data-count={s.value}>{s.value}</b>
          <span>{s.label}</span>
        </div>
      ))
    }
  </div>
  <button class="btn btn--small widget__action" type="button" data-ship style="--hue: var(--green)">Ship it</button>
</div>
