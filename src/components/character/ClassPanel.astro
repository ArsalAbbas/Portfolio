---
// The panel for one class: a few words, maybe a photo, and the class's toy from ./widgets.
import { Image } from 'astro:assets'
import desk from '../../assets/photos/desk.webp'
import focus from '../../assets/photos/focus.webp'
import type { CharacterClass, Widget } from '../../data/character'
import Dishes from './widgets/Dishes.astro'
import FieldNotes from './widgets/FieldNotes.astro'
import Kalimba from './widgets/Kalimba.astro'
import Rally from './widgets/Rally.astro'
import Route from './widgets/Route.astro'
import Sketch from './widgets/Sketch.astro'
import Stats from './widgets/Stats.astro'
import V60 from './widgets/V60.astro'

interface Props {
  cls: CharacterClass
  /** shown when the page loads */
  open: boolean
}

const { cls, open } = Astro.props
const widgets: Record<Widget, typeof Stats> = {
  stats: Stats,
  fieldnotes: FieldNotes,
  sketch: Sketch,
  v60: V60,
  dishes: Dishes,
  route: Route,
  rally: Rally,
  kalimba: Kalimba,
}
const Toy = widgets[cls.widget]
const photos: Partial<Record<CharacterClass['id'], { src: ImageMetadata; alt: string }>> = {
  engineer: { src: focus, alt: 'Arsal working on a laptop in a café' },
  barista: { src: desk, alt: 'Arsal at a café table with a coffee and a laptop' },
}
const photo = photos[cls.id]
---

<div
  class="panel"
  role="tabpanel"
  id={`panel-${cls.id}`}
  aria-labelledby={`tab-${cls.id}`}
  hidden={!open}
  data-panel={cls.id}
  style={`--hue: var(--${cls.hue})`}
>
  <h2>{cls.name}</h2>
  <p>{cls.blurb}</p>
  {photo && <Image class="panel__photo" src={photo.src} alt={photo.alt} widths={[320, 560]} sizes="280px" />}
  {
    cls.costumes && (
      <button class="btn btn--small panel__costume" type="button" data-costume-next data-costumes={JSON.stringify(cls.costumes)} style="--hue: var(--pink)">
        Try a costume
      </button>
    )
  }
  <Toy />
  {cls.psst && <p class="fineprint panel__psst">{cls.psst}</p>}
</div>
